# ---- LLM / vector RAG ----
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Must match your Pinecone index dimension
GEMINI_EMBED_DIM=768
PINECONE_API_KEY=
PINECONE_INDEX=crop_disease1
DEFAULT_NAMESPACE=global
RAG_SIMILARITY_THRESHOLD=0.75
# Store Gemini answers back into Pinecone when no context matched
RAG_CACHE_LLM_ANSWERS=true

# ---- Databases (docker compose) ----
POSTGRES_USER=agribot
POSTGRES_PASSWORD=agribot_pass
POSTGRES_DB=agribot
DATABASE_URL=postgresql+psycopg://agribot:agribot_pass@localhost:5433/agribot

MONGO_USER=agribot
MONGO_PASSWORD=agribot_pass
MONGO_URL=mongodb://agribot:agribot_pass@localhost:27018/?authSource=admin
MONGO_DB=agribot

NEO4J_USER=neo4j
NEO4J_PASSWORD=agribot_pass
NEO4J_URI=bolt://localhost:7687
GRAPH_RAG_ENABLED=true

# ---- Models ----
# YOLOv8n PlantDoc leaf-disease detector
DISEASE_MODEL_PATH=models/plantdoc_yolov8n.pt
DISEASE_CONF_THRESHOLD=0.25
CROP_MODEL_PATH=ml/artifacts/crop_recommender.joblib
WHISPER_MODEL=small

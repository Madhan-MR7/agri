{
  "expo": {
    "name": "AgriBot",
    "slug": "agribot",
    "scheme": "agribot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agribot.app"
    },
    "android": {
      "package": "com.agribot.app",
      "adaptiveIcon": {
        "backgroundColor": "#E8F5E9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "AgriBot needs your photos to check crop leaves for disease.",
          "cameraPermission": "AgriBot uses the camera to photograph crop leaves for disease detection.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "AgriBot uses the microphone so you can ask questions by voice."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
